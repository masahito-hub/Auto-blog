# ============================================
# Blog Pipeline Configuration
# ============================================
# Copy this file to .env and fill in your values
# Then run: chmod 600 .env

# ============================================
# WordPress Configuration (REQUIRED)
# ============================================

# Your WordPress site URL (without trailing slash)
# Example: https://myblog.com or https://example.com/blog
WP_BASE_URL=https://your-wordpress-site.com

# WordPress username with Editor or Administrator role
WP_USER=your_username

# WordPress Application Password (NOT your login password!)
# Generate from: WordPress Admin → Users → Profile → Application Passwords
# Format: xxxx xxxx xxxx xxxx (24 characters, spaces optional)
# See docs/SETUP.md for detailed instructions
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# Slack Notifications (OPTIONAL)
# ============================================

# Slack incoming webhook URL for notifications
# Leave empty to disable Slack notifications
# Get webhook: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ============================================
# Image Generation (MVP: Disabled)
# ============================================

# Image provider: none (default) | openai | replicate
# MVP only supports "none" (existing images only)
IMAGES_PROVIDER=none

# ============================================
# Directory Paths (OPTIONAL)
# ============================================
# Override default paths if needed
# Defaults are relative to project root:
#   BASE_DIR = current working directory
#   INBOX_DIR = {BASE_DIR}/var/inbox
#   WORK_DIR = {BASE_DIR}/var/work
#   PUBLISHED_DIR = {BASE_DIR}/var/published
#   DB_PATH = {BASE_DIR}/var/queue.db

# BASE_DIR=/opt/blog-pipeline
# INBOX_DIR=/opt/blog-pipeline/var/inbox
# WORK_DIR=/opt/blog-pipeline/var/work
# PUBLISHED_DIR=/opt/blog-pipeline/var/published
# DB_PATH=/opt/blog-pipeline/var/queue.db

# ============================================
# Server Configuration (OPTIONAL)
# ============================================

# FastAPI server bind address
# Use 0.0.0.0 to accept connections from any network interface
# Use 127.0.0.1 to only accept local connections
SERVER_HOST=0.0.0.0

# FastAPI server port
SERVER_PORT=8000

# ============================================
# Queue & Retry Configuration (OPTIONAL)
# ============================================

# Maximum number of retry attempts for failed jobs
MAX_RETRIES=5

# Retry delay schedule in seconds (comma-separated)
# Default: 1min, 5min, 15min, 1hour, 6hours
RETRY_DELAYS=60,300,900,3600,21600

# ============================================
# Logging (OPTIONAL)
# ============================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
